<?xml version="1.1" encoding="UTF-8"?>

<channel name="xfce4-panel" version="1.0">
  <property name="configver" type="int" value="2"/>
  <property name="panels" type="array">
    <value type="int" value="1"/>
    <property name="dark-mode" type="bool" value="true"/>
    <property name="panel-1" type="empty">
      <!--
        p=6 = top-center anchor. No absolute x/y pixel offsets (the old
        config had x=634 baked in from one specific screen resolution and
        position-locked=true, so on any other resolution the panel could
        render off-screen). length-adjust=true makes "length" a PERCENTAGE
        of the output width (0-100), not a pixel value - the old 62 here
        meant "62% of screen width", which is exactly why the panel looked
        too short/didn't reach the edges. 100 = full width.
      -->
      <property name="position" type="string" value="p=6;x=0;y=8"/>
      <property name="length" type="double" value="100"/>
      <property name="length-adjust" type="bool" value="true"/>
      <property name="position-locked" type="bool" value="false"/>
      <property name="icon-size" type="uint" value="24"/>
      <property name="size" type="uint" value="48"/>
